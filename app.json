{
  "expo": {
    "name": "FoodApp",
    "slug": "FoodApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "foodapp",
    "userInterfaceStyle": "automatic",
    "android": { "predictiveBackGestureEnabled": false },
    "web": { "output": "static" },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Matreddarna need camera access to scan your fridge."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#100E11"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
