{
  "expo": {
    "name": "FoodApp",
    "slug": "FoodApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "foodapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.williamgasimov.foodapp",
      "supportsTablet": true
    },
    "android": {
      "package": "com.williamgasimov.foodapp",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Matreddarna need camera access to scan your fridge."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#100E11"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63f69030-6a50-4a09-938b-06fc4ecb51c5"
      }
    }
  }
}
